# Copy thành .env rồi điền giá trị. Không commit .env.

# --- Docker Postgres / Redis (bind localhost, port non-default) ---
POSTGRES_USER=digitalboo
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_24
POSTGRES_DB=digitalboo
POSTGRES_HOST_PORT=15432

REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_24
REDIS_HOST_PORT=16379

# App kết nối (host chạy FastAPI)
DATABASE_URL=postgresql://digitalboo:CHANGE_ME_openssl_rand_base64_24@127.0.0.1:15432/digitalboo
REDIS_URL=redis://:CHANGE_ME_openssl_rand_base64_24@127.0.0.1:16379/0

# --- Model (OpenAI) — harness orchestrator + CP2 call_model ---
MODEL_PROVIDER=openai
MODEL_NAME=gpt-6-luna
API_KEY=

# --- FastAPI / OAuth Gmail ---
APP_HOST=127.0.0.1
APP_PORT=8000
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
DEFAULT_USER_ID=u1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Standup computer-use ---
STANDUP_ALLOWLIST_URL=https://example.com/standup
PLAYWRIGHT_USER_DATA_DIR=harness/state/browser
PLAYWRIGHT_HEADLESS=0
LOGIN_WAIT_TIMEOUT_SEC=300

# --- Scheduler ---
EMAIL_WATCH_INTERVAL_SEC=300
STANDUP_TIMEZONE=Asia/Ho_Chi_Minh
